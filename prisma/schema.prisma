// Prisma Schema — QuickCash Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────
model User {
  id                String         @id @default(cuid())
  phone             String         @unique
  name              String?
  email             String?
  pinHash           String?
  kycStatus         String         @default("PENDING")
  creditScore       Int            @default(500)
  referralCode      String?        @unique
  referredById      String?
  referralCredit    Float          @default(0)
  referralBonusPaid Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  loans             Loan[]
  guarantors        Guarantor[]
  kyc               Kyc?
  notifications     Notification[]
  savings           Savings?
  referredBy        User?          @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers     User[]         @relation("Referrals")

  @@index([phone])
  @@index([referralCode])
}

// ─────────────────────────────────────────────
// OTP
// ─────────────────────────────────────────────
model Otp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

// ─────────────────────────────────────────────
// GUARANTORS
// ─────────────────────────────────────────────
model Guarantor {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  relationship String
  idNumber     String?
  status       String    @default("PENDING")
  otpCode      String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// KYC
// ─────────────────────────────────────────────
model Kyc {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType  String
  frontImageUrl String?
  backImageUrl  String?
  selfieUrl     String?
  status        String    @default("PENDING")
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─────────────────────────────────────────────
// LOANS
// ─────────────────────────────────────────────
model Loan {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Float
  interestRate    Float
  totalDue        Float
  dailyPayment    Float
  durationDays    Int
  purpose         String?
  status          String    @default("PENDING")
  appliedAt       DateTime  @default(now())
  approvedAt      DateTime?
  dueDate         DateTime?
  rejectionReason String?
  rejectedAt      DateTime?
  creditApplied   Float     @default(0)

  repayments      Repayment[]

  @@index([userId])
}

// ─────────────────────────────────────────────
// REPAYMENTS
// ─────────────────────────────────────────────
model Repayment {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount    Float
  method    String
  reference String?
  status    String   @default("SUCCESSFUL")
  createdAt DateTime @default(now())

  @@index([loanId])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

// ─────────────────────────────────────────────
// SAVINGS
// ─────────────────────────────────────────────
model Savings {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float     @default(0)
  goal      Float?
  goalName  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transactions SavingsTransaction[]
}

// ─────────────────────────────────────────────
// SAVINGS TRANSACTIONS
// ─────────────────────────────────────────────
model SavingsTransaction {
  id        String   @id @default(cuid())
  savingsId String
  savings   Savings  @relation(fields: [savingsId], references: [id], onDelete: Cascade)
  type      String   // DEPOSIT, WITHDRAWAL
  amount    Float
  method    String?  // MTN_MOMO, AIRTEL_MONEY, BANK
  reference String?
  createdAt DateTime @default(now())

  @@index([savingsId])
}